# MySQL Connection String (e.g. mysql://username:password@host:port/database)
DATABASE_URL=mysql://root:password@localhost:3306/ielts_web

# JWT secret used to sign session cookies. REQUIRED — without it the app falls
# back to a public hard-coded key, letting anyone forge admin sessions.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret

# AI Configurations (any OpenAI-compatible endpoint).
# Default below is Groq (free, fast). Get a key at https://console.groq.com/keys
FIREWORKS_API_KEY=your-groq-api-key
FIREWORKS_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile

# Deepgram TTS API Key (Optional, for Text-to-Speech)
DEEPGRAM_API_KEY=your-deepgram-api-key
